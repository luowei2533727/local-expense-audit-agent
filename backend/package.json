{
  "name": "expense-pilot-backend",
  "version": "1.0.0",
  "description": "本地费用审核 Agent API",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "localize:demo": "tsx scripts/localize-demo-data.ts",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "test": "tsx --test test/*.test.ts",
    "check:local": "tsx scripts/check-local.ts",
    "benchmark:50": "tsx scripts/benchmark-50.ts",
    "dataset:wildreceipt": "tsx scripts/download-wildreceipt.ts",
    "benchmark:real": "tsx scripts/benchmark-wildreceipt.ts",
    "dataset:paddle-vat": "tsx scripts/prepare-paddle-vat.ts",
    "benchmark:paddle-vat": "tsx scripts/benchmark-paddle-vat.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "sharp": "0.35.5",
    "typebox": "1.3.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
