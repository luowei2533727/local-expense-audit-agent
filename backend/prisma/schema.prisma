// ExpensePilot Agent - Prisma schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id            String   @id @default(cuid())
  name          String
  currency_code String   @default("USD")
  country       String
  created_at    DateTime @default(now())

  users             User[]
  approval_policies ApprovalPolicy[]

  @@map("companies")
}

model User {
  id                  String   @id @default(cuid())
  company_id          String
  email               String   @unique
  password_hash       String
  role                String   @default("EMPLOYEE")
  manager_id          String?
  is_manager_approver Boolean  @default(false)
  refresh_token       String?
  created_at          DateTime @default(now())

  company  Company @relation(fields: [company_id], references: [id])
  manager  User?   @relation("ManagerEmployee", fields: [manager_id], references: [id])
  reports  User[]  @relation("ManagerEmployee")

  expenses          Expense[]         @relation("EmployeeExpenses")
  receipt_assets    ReceiptAsset[]    @relation("ReceiptOwner")
  approval_requests ApprovalRequest[] @relation("ApproverRequests")
  audit_logs_actor  AuditLog[]        @relation("ActorLogs")
  specific_steps    ApprovalStep[]    @relation("SpecificApprover")
  specific_policies ApprovalPolicy[]  @relation("SpecificApprover")

  @@map("users")
}

model Expense {
  id               String        @id @default(cuid())
  employee_id      String
  amount           Float
  currency         String
  converted_amount Float?
  base_currency    String?
  category         String
  description      String
  expense_date     DateTime
  status           String   @default("PENDING")
  receipt_url      String?
  merchant_name    String?
  created_at       DateTime      @default(now())

  employee          User              @relation("EmployeeExpenses", fields: [employee_id], references: [id])
  approval_requests ApprovalRequest[]
  audit_logs        AuditLog[]
  agent_assessments AgentAssessment[]
  receipt_asset     ReceiptAsset?

  @@map("expenses")
}

model ApprovalPolicy {
  id                    String   @id @default(cuid())
  company_id            String
  name                  String
  rule_type             String   @default("SEQUENTIAL")
  percentage_threshold  Float?
  specific_approver_id  String?

  company           Company        @relation(fields: [company_id], references: [id])
  specific_approver User?          @relation("SpecificApprover", fields: [specific_approver_id], references: [id])
  steps             ApprovalStep[]

  @@map("approval_policies")
}

model ApprovalStep {
  id               String  @id @default(cuid())
  policy_id        String
  step_order       Int
  approver_role    String?
  approver_user_id String?

  policy            ApprovalPolicy    @relation(fields: [policy_id], references: [id])
  specific_approver User?             @relation("SpecificApprover", fields: [approver_user_id], references: [id])
  approval_requests ApprovalRequest[]

  @@map("approval_steps")
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  expense_id  String
  step_id     String
  approver_id String
  status      String   @default("PENDING")
  comment     String?
  decided_at  DateTime?
  created_at  DateTime       @default(now())

  expense  Expense      @relation(fields: [expense_id], references: [id])
  step     ApprovalStep @relation(fields: [step_id], references: [id])
  approver User         @relation("ApproverRequests", fields: [approver_id], references: [id])

  @@map("approval_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  expense_id String
  actor_id   String
  action     String
  metadata   String   @default("{}")
  ip_address String?
  created_at DateTime @default(now())

  expense Expense @relation(fields: [expense_id], references: [id])
  actor   User    @relation("ActorLogs", fields: [actor_id], references: [id])

  @@map("audit_logs")
}

model AgentAssessment {
  id                    String   @id @default(cuid())
  expense_id            String
  model                 String
  recommendation        String
  risk_level            String
  summary               String
  checks_json           String
  missing_documents     String
  confidence            Float
  human_review_required Boolean  @default(true)
  guardrail_applied     Boolean  @default(false)
  trace_id              String
  metrics_json          String
  created_at            DateTime @default(now())

  expense Expense @relation(fields: [expense_id], references: [id])

  @@index([expense_id, created_at])
  @@map("agent_assessments")
}

model ReceiptAsset {
  id           String   @id @default(cuid())
  owner_id     String
  expense_id   String?  @unique
  file_name    String
  mime_type    String
  size_bytes   Int
  sha256       String
  created_at   DateTime @default(now())

  owner   User     @relation("ReceiptOwner", fields: [owner_id], references: [id])
  expense Expense? @relation(fields: [expense_id], references: [id])

  @@index([owner_id, sha256])
  @@map("receipt_assets")
}

model AgentTrace {
  id          Int      @id @default(autoincrement())
  trace_id    String
  sequence    Int
  event_type  String
  detail_json String
  created_at  DateTime @default(now())

  @@unique([trace_id, sequence])
  @@index([trace_id])
  @@map("agent_traces")
}
